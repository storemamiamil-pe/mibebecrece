# ============================================================================
# Copia este archivo como ".env.local" para desarrollo local, y configura
# estas mismas variables en Vercel (Project Settings → Environment Variables)
# para producción. NUNCA subas un archivo con secretos reales a GitHub.
# ============================================================================

# --- Supabase ---
# Los encuentras en tu proyecto de Supabase: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# ⚠️ SECRETO — nunca debe llevar el prefijo NEXT_PUBLIC_, ni exponerse al
# navegador. Solo se usa en Route Handlers del servidor (app/api/**).
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta

# --- Hotmart ---
# El Hottok lo encuentras en Hotmart: Herramientas → Webhook → pestaña
# "Autenticación" de tu producto.
HOTMART_HOTTOK=tu-hottok-secreto

# El ID del producto autorizado (Herramientas → tu producto → ID del
# producto). Evita que comprar OTRO producto de Hotmart active esta app.
HOTMART_PRODUCT_ID=1234567

# --- App ---
# URL pública donde queda publicada la app en Vercel (sin slash al final).
NEXT_PUBLIC_APP_URL=https://tu-app.vercel.app

# --- Soporte ---
# También puedes editar directamente lib/config.js si prefieres no usar
# variables de entorno para esto.
SUPPORT_WHATSAPP_URL=https://wa.me/000000000000
SUPPORT_EMAIL=soporte@tu-dominio.com

# --- Administración ---
# Lista de correos autorizados para entrar a /admin, separados por coma,
# sin espacios extra. Deben coincidir exactamente con el correo de la
# cuenta de Supabase Auth de cada administradora.
ADMIN_EMAILS=tu-correo@dominio.com,otra-admin@dominio.com
